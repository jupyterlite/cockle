{
  "extends": "../tsconfig",
  "compilerOptions": {
    "composite": false,
    "outDir": "dist",
    "rootDir": "../",
    "types": ["jest", "node"],
    "paths": {
      "@jupyterlite/cockle": ["./node_modules/@jupyterlite/cockle"]
    }
  },
  "include": [
    "../sample-commands/external/*",
    "../src/**/*",
    "integration-tests/*",
    "serve/*",
    "unit-tests/*"
  ],
  "exclude": ["../src/tools"]
}
